# 换行符策略
# 仓库在 Windows 上开发，但可能被 clone 到 Linux —— 统一由 git 管理换行符。

* text=auto

# Windows 专用脚本必须保持 CRLF（PowerShell 5.1 对 LF-only 的 .ps1 处理不稳）
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Shell 脚本必须保持 LF，否则在 Linux 上会报 "bad interpreter"
*.sh   text eol=lf

# 二进制文件不做任何转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.jar  binary
*.class binary
*.zip  binary
